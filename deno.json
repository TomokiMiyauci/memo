{
  "tasks": {
    "test": "deno test --import-map=./_test_import_map.json --doc",
    "build:npm": "deno run -A --no-lock _tools/build_npm.ts"
  },
  "fmt": {
    "exclude": ["CHANGELOG.md"]
  },
  "lint": {
    "exclude": ["CHANGELOG.md"]
  },
  "test": {
    "exclude": ["CHANGELOG.md", "npm"]
  },
  "compilerOptions": {
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@miyauci/composite-key": "jsr:@miyauci/composite-key@^1.1.0",
    "@miyauci/upsert": "jsr:@miyauci/upsert@^1.3.0",
    "@std/assert": "jsr:@std/assert@^0.226.0",
    "@std/testing": "jsr:@std/testing@^0.225.3"
  }
}
